# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Used by memtrust.llm.openai.OpenAIClient.from_env() for the semantic checks
# (memtrust.checks.semantic) and by benchmarks/eval_detectors.py.

# Required for LLM-backed checks.
OPENAI_API_KEY=sk-your-key-here

# Optional: model for the judge / conflict / known-answer checks (default: gpt-5-mini).
MEMTRUST_OPENAI_MODEL=gpt-5-mini

# Optional: reasoning effort for reasoning models (minimal | low | medium | high).
# Defaults to "low" for gpt-5*/o* models; leave empty for non-reasoning models.
MEMTRUST_OPENAI_REASONING_EFFORT=

# Optional: OpenAI-compatible endpoint (Azure OpenAI, gateway, local server).
OPENAI_BASE_URL=

# Optional: per-request timeout in seconds (default: 15).
MEMTRUST_LLM_TIMEOUT=15

# Optional: Hugging Face token for the gated meta-llama/Llama-Prompt-Guard-2-86M
# classifier (PromptGuardCheck). Not needed for leolee99/PIGuard.
# HF_TOKEN=hf_your-token-here
